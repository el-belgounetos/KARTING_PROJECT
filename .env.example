# ==============================================================================
# Tournament Project Environment Configuration
# ==============================================================================

# Database selection:
# Default embedded H2: leave COMPOSE_PROFILES empty or "default"
# Optional PostgreSQL: set COMPOSE_PROFILES=postgres and SPRING_PROFILES_ACTIVE=postgres
COMPOSE_PROFILES=default
SPRING_PROFILES_ACTIVE=default

# PostgreSQL credentials (active when COMPOSE_PROFILES=postgres)
POSTGRES_DB=natkart
POSTGRES_USER=kart_admin
POSTGRES_PASSWORD=kart_secret
POSTGRES_PORT=5432

# Ports
SERVER_PORT=8080
FRONTEND_PORT=4200
DISCOVERY_UDP_PORT=45454
